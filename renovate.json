{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>projectbluefin/renovate-config"
  ],
  "baseBranchPatterns": ["testing"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/image-versions(\\.[^.]+)?\\.(yaml|yml)$/"],
      "matchStrings": [
        "image:\\s*(?<packageName>\\S+)\\s*tag:\\s*(?<currentValue>\\S+)\\s*digest:\\s*(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge digest/pin/patch/minor for all dependencies",
      "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Never SHA-pin projectbluefin/actions or projectbluefin/testsuite refs — use @v1 managed tags; SHA pins break the no-sha-pins-for-internal-actions pre-commit hook and block automerge",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["/^projectbluefin\/(actions|testsuite)/"],
      "pinDigests": false,
      "enabled": false
    }
  ]
}

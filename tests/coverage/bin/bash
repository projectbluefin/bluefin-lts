#!/usr/bin/bash
set -euo pipefail

real_bash="/usr/bin/bash"

kcov_bin="$(command -v kcov || true)"

if [[ "${KCOV_ACTIVE:-}" == "1" || -z "${KCOV_RAW_DIR:-}" ||
    -z "${KCOV_REPO_ROOT:-}" || -z "${kcov_bin}" || ! -d "${KCOV_RAW_DIR}" ||
    $# -eq 0 || "$1" == -* || ! -f "$1" ]]; then
    exec "${real_bash}" "$@"
fi

script="$(realpath "$1")"
source_path=""

case "${script}" in
    "${KCOV_REPO_ROOT}"/build_scripts/* | "${KCOV_REPO_ROOT}"/system_files/*)
        source_path="${script}"
        ;;
    */sandbox/*-patched.sh | */.bats-sandbox/*)
        source_name="$(basename "${script}")"
        source_name="${source_name/-patched/}"
        mapfile -t source_matches < <(
            find "${KCOV_REPO_ROOT}/build_scripts" -maxdepth 1 -type f -name "${source_name}" -print
            find "${KCOV_REPO_ROOT}/build_scripts" -maxdepth 1 -type f -name "[0-9][0-9]-${source_name}" -print
            find "${KCOV_REPO_ROOT}/system_files" -type f -name "${source_name}" -print
        )
        if [[ ${#source_matches[@]} -eq 0 ]]; then
            mapfile -t source_matches < <(
                find "${KCOV_REPO_ROOT}/build_scripts" "${KCOV_REPO_ROOT}/system_files" \
                    -type f -name "${source_name}" -print
                find "${KCOV_REPO_ROOT}/build_scripts" "${KCOV_REPO_ROOT}/system_files" \
                    -type f -name "[0-9][0-9]-${source_name}" -print
            )
        fi
        if [[ ${#source_matches[@]} -eq 1 ]]; then
            source_path="$(realpath "${source_matches[0]}")"
        elif [[ ${#source_matches[@]} -gt 1 ]]; then
            echo "warning: ambiguous source matches for ${source_name}: ${source_matches[*]}" >&2
        fi
        ;;
esac

if [[ -z "${source_path}" ]]; then
    exec "${real_bash}" "$@"
fi

run_dir="$(mktemp -d "${KCOV_RAW_DIR}/run.XXXXXX")"
printf '%s\n' "${source_path}" > "${run_dir}/source-path"
shift
exec env KCOV_ACTIVE=1 "${kcov_bin}" \
    --bash-method=DEBUG \
    --include-path="$(dirname "${script}"),${KCOV_REPO_ROOT}/build_scripts,${KCOV_REPO_ROOT}/system_files" \
    --exclude-path="${KCOV_REPO_ROOT}/.github" \
    "${run_dir}" \
    "${script}" "$@"

# Uranium Plymouth Theme Script

# Set the background color
Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

# Load the logo image
logo.image = Image("thallium.svg");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(Window.GetWidth() / 2 - logo.image.GetWidth() / 2,
                        Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 50);

# Progress bar
progress_box.image = Image("progress-box.png");
progress_box.sprite = Sprite(progress_box.image);
progress_box.sprite.SetPosition(Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2,
                                Window.GetHeight() / 2 + 50);

progress_bar.image = Image("progress-bar.png");
progress_bar.sprite = Sprite(progress_bar.image);
progress_bar.sprite.SetPosition(Window.GetWidth() / 2 - progress_bar.image.GetWidth() / 2,
                                Window.GetHeight() / 2 + 50);

# Animation
fun progress_callback(duration, progress) {
    progress_bar.sprite.SetOpacity(progress);
}

Plymouth.SetBootProgressFunction(progress_callback);

# Status message
status.sprite = Sprite();
status.sprite.SetPosition(Window.GetWidth() / 2 - 100,
                          Window.GetHeight() / 2 + 120);

fun status_callback(text) {
    status.image = Image.Text(text, 1.0, 1.0, 1.0, 20);
    status.sprite.SetImage(status.image);
}

Plymouth.SetUpdateStatusFunction(status_callback);